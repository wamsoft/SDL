# Pre-compiles the GPU renderer's D3D12 shaders for Xbox (cmake -P).
#
# The DXIL headers next to this file are generic DXIL, which the Xbox runtime
# recompiles at load time (XBSC W1003). Compiling the same HLSL with the GXDK
# dxc of the target console embeds the hardware code, but that requires a root
# signature in the shader. The root signatures below are what
# D3D12_INTERNAL_CreateGraphicsRootSignature() in src/gpu/d3d12/SDL_gpu_d3d12.c
# builds for each pipeline (same order, same ranges), using the sampler /
# uniform buffer counts from frag_shader_sources / vert_shader_sources in
# SDL_shaders_gpu.c.
#
# A vertex shader is shared by several pipelines, so it can only match one of
# them: tri_texture.vert uses the root signature of its pairing with the
# single-texture fragment shaders.
#
# Inputs: -DDXC=<GXDK dxc.exe> -DSRC_DIR=<this directory> -DOUT=<header to write>

if(NOT DXC OR NOT EXISTS "${DXC}")
  message(FATAL_ERROR "GXDK dxc not found: '${DXC}'")
endif()

set(rs_head "RootFlags(ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT), CBV(b0, space=1, visibility=SHADER_VISIBILITY_VERTEX)")

# Root signature of a pipeline whose fragment shader has <samplers> samplers.
function(sdl_xbox_root_signature samplers out_var)
  set(rs "${rs_head}")
  if(samplers GREATER 0)
    string(APPEND rs ", DescriptorTable(Sampler(s0, space=2, numDescriptors=${samplers}), visibility=SHADER_VISIBILITY_PIXEL)")
    string(APPEND rs ", DescriptorTable(SRV(t0, space=2, numDescriptors=${samplers}), visibility=SHADER_VISIBILITY_PIXEL)")
  endif()
  string(APPEND rs ", CBV(b0, space=3, visibility=SHADER_VISIBILITY_PIXEL)")
  set(${out_var} "${rs}" PARENT_SCOPE)
endfunction()

# <file stem>|<profile>|<fragment shader sampler count of the pipeline>
set(shaders
  "linepoint.vert|vs_6_0|0"
  "tri_color.vert|vs_6_0|0"
  "tri_texture.vert|vs_6_0|1"
  "color.frag|ps_6_0|0"
  "texture_rgb.frag|ps_6_0|1"
  "texture_rgba.frag|ps_6_0|1"
  "texture_advanced.frag|ps_6_0|3"
)

get_filename_component(work "${OUT}" DIRECTORY)
set(work "${work}/sdl_render_gpu_xbox")
file(MAKE_DIRECTORY "${work}")

set(header "// Generated by compile_shaders_xbox.cmake. Do not edit.\n")
foreach(entry IN LISTS shaders)
  string(REPLACE "|" ";" entry "${entry}")
  list(GET entry 0 stem)
  list(GET entry 1 profile)
  list(GET entry 2 samplers)
  string(REPLACE "." "_" var "${stem}_dxil")
  sdl_xbox_root_signature(${samplers} rs)
  set(wrapper "${work}/${stem}.hlsl")
  if(profile MATCHES "^vs_")
    # SDL_gpu_d3d12.c declares every vertex input as TEXCOORD<location>, and
    # the renderer assigns locations in VSInput member order. The generic
    # headers get this from the SPIR-V round trip in shadercross; do the same
    # renaming here (inputs only; outputs must keep matching the pixel shaders).
    file(READ "${SRC_DIR}/${stem}.hlsl" src)
    string(FIND "${src}" "struct VSInput" begin)
    if(begin EQUAL -1)
      message(FATAL_ERROR "${stem}: struct VSInput not found")
    endif()
    string(SUBSTRING "${src}" ${begin} -1 tail)
    string(FIND "${tail}" "};" len)
    string(SUBSTRING "${tail}" 0 ${len} block)
    # ';' is CMake's list separator; keep it out of the matched strings
    string(REPLACE ";" "@SDL_XBOX_SC@" renamed "${block}")
    string(REGEX MATCHALL ":[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*@SDL_XBOX_SC@" semantics "${renamed}")
    set(index 0)
    foreach(sem IN LISTS semantics)
      string(FIND "${renamed}" "${sem}" at)
      string(LENGTH "${sem}" sem_len)
      string(SUBSTRING "${renamed}" 0 ${at} head)
      math(EXPR rest_at "${at} + ${sem_len}")
      string(SUBSTRING "${renamed}" ${rest_at} -1 rest)
      set(renamed "${head}: @SDL_XBOX_SEM_${index}@@SDL_XBOX_SC@${rest}")
      math(EXPR index "${index} + 1")
    endforeach()
    string(REGEX REPLACE "@SDL_XBOX_SEM_([0-9]+)@" "TEXCOORD\\1" renamed "${renamed}")
    string(REPLACE "@SDL_XBOX_SC@" ";" renamed "${renamed}")
    string(REPLACE "${block}" "${renamed}" src "${src}")
    file(WRITE "${wrapper}" "#define SDL_XBOX_RS \"${rs}\"\n${src}")
  else()
    file(WRITE "${wrapper}" "#define SDL_XBOX_RS \"${rs}\"\n#include \"${SRC_DIR}/${stem}.hlsl\"\n")
  endif()
  execute_process(
    COMMAND "${DXC}" -nologo -T ${profile} -E main -rootsig-define SDL_XBOX_RS
            -Fh "${work}/${stem}.h" -Vn ${var} "${wrapper}"
    RESULT_VARIABLE res
    OUTPUT_VARIABLE log
    ERROR_VARIABLE log)
  if(NOT res EQUAL 0)
    message(FATAL_ERROR "dxc failed for ${stem}:\n${log}")
  endif()
  file(READ "${work}/${stem}.h" body)
  string(APPEND header "${body}\n")
endforeach()

file(WRITE "${OUT}.tmp" "${header}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
